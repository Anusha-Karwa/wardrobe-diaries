# Google Gemini — https://aistudio.google.com → "Get API key"
GEMINI_API_KEY=
# Latest Gemini Flash model ID. Leave blank to use Google's "gemini-flash-latest" alias,
# or pin a version from https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=
# Neon Postgres (pooled connection string) — Vercel → Storage → Neon, or neon.tech
DATABASE_URL=
# Vercel Blob — Vercel → Storage → Blob
BLOB_READ_WRITE_TOKEN=
# Optional passcode lock. Off unless REQUIRE_PASSCODE=true.
REQUIRE_PASSCODE=false
APP_PASSCODE=
# Long random string; Vercel sends it as a Bearer token to /api/cron/*
CRON_SECRET=

# --- Optional (Phase 2 extraction) ---
# Image model used to make "AI product shot" cutouts of worn items (mirror selfies).
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
# Gemini segmentation masks are off by default (slow/empty on current Gemini 3 Flash models). "on" to try them.
GEMINI_SEGMENTATION=off
